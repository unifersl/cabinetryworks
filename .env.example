# CabinetryWorks — Environment Variables
# Copy this file to .env and fill in your values
# For local dev with SQLite: DATABASE_URL="file:./db/custom.db" (and change prisma provider to "sqlite")
# For production with Supabase: DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Database (REQUIRED)
# Local SQLite:
# DATABASE_URL="file:./db/custom.db"
#
# Supabase PostgreSQL (production):
# DATABASE_URL="postgresql://postgres.abcdefghijklmnop:your-password@aws-0-region.pooler.supabase.com:6543/postgres"
#
# Direct connection (for migrations):
# DIRECT_URL="postgresql://postgres.abcdefghijklmnop:your-password@db.abcdefghijklmnop.supabase.co:5432/postgres"

# Session secret (REQUIRED — generate a random string)
# Run: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-string-at-least-32-chars"

# App URL (for production — your Vercel domain)
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
