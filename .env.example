# CabinetryWorks — Environment Variables
# Copy to .env for local dev, OR set these in Vercel Dashboard → Settings → Environment Variables.

# ─── Database (required for Vercel) ───────────────────────────────────────
# Supabase Transaction Pooler URL (port 6543 — NOT direct connection port 5432).
# Get this from: Supabase Dashboard → Settings → Database → Connection string → Transaction pooler
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres"

# ─── Supabase connection params (optional — fallbacks are hardcoded) ─────
# These are used by src/lib/db.ts for the Prisma adapter. If not set, the
# hardcoded fallback values are used. Set these on Vercel for production.
SUPABASE_HOST="aws-0-ap-southeast-2.pooler.supabase.com"
SUPABASE_PORT="6543"
SUPABASE_DB="postgres"
SUPABASE_USER="postgres.YOUR_PROJECT_REF"
SUPABASE_PASSWORD="YOUR_PASSWORD"

# ─── Session secret (optional but recommended for production) ─────────────
# Used to HMAC-sign session cookies. If not set, a derived fallback is used
# (less secure). Generate a strong random string:
#   openssl rand -hex 32
SESSION_SECRET="generate-a-random-32-char-hex-string-here"

# ─── For local dev with SQLite ────────────────────────────────────────────
# If you want to use SQLite locally instead of Postgres:
# 1. Set DATABASE_URL="file:./db/custom.db"
# 2. Change prisma/schema.prisma provider to "sqlite"
# 3. Run: bun run db:push
